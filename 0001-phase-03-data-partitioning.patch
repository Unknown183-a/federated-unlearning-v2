+++ b/frontend/src/components/PartitionSummary.jsx
@@ -0,0 +1,60 @@
+const STRATEGY_LABEL = {
+  iid: "IID",
+  non_iid: "Non-IID",
+};
+
+export default function PartitionSummary({ partition }) {
+  return (
+    <div>
+      <h2>Partition Summary</h2>
+      <dl>
+        <div>
+          <dt>Total Samples</dt>
+          <dd>{partition.total_samples.toLocaleString()}</dd>
+        </div>
+        <div>
+          <dt>Clients</dt>
+          <dd>{partition.num_clients}</dd>
+        </div>
+        <div>
+          <dt>Average Samples / Client</dt>
+          <dd>{Math.round(partition.average_samples_per_client).toLocaleString()}</dd>
+        </div>
+        <div>
+          <dt>Most Imbalanced Client</dt>
+          <dd>Client {partition.most_imbalanced_client}</dd>
+        </div>
+        <div>
+          <dt>Partition</dt>
+          <dd>{STRATEGY_LABEL[partition.strategy] || partition.strategy}</dd>
+        </div>
+        <div>
+          <dt>Random Seed</dt>
+          <dd>{partition.seed}</dd>
+        </div>
+      </dl>
+
+      <table>
+        <caption>Samples and classes per client</caption>
+        <thead>
+          <tr>
+            <th>Client</th>
+            <th>Samples</th>
+            <th>Classes Present</th>
+          </tr>
+        </thead>
+        <tbody>
+          {partition.clients.map((client) => (
+            <tr key={client.client_id}>
+              <td>Client {client.client_id}</td>
+              <td>{client.num_samples.toLocaleString()}</td>
+              <td>
+                {client.num_classes_present} / {partition.num_classes}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  );
+}
