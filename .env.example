# Copy to .env (gitignored) in the directory you start the backend from.
# Express loads this with dotenv; the Python compute layer inherits it.
# Never prefix these with VITE_ -- anything VITE_-prefixed is bundled into
# the browser. These must stay server-side only.

# College GPU server running this project's core/ behind the compute HTTP protocol
COLLEGE_GPU_BASE_URL=
COLLEGE_GPU_API_KEY=

# Google Colab runtime exposed through a tunnel (ngrok / cloudflared)
COLAB_BASE_URL=
COLAB_API_KEY=

# Phase 15 (optional)
# Python executable the backend launches for training/unlearning/evaluation.
# PYTHON_BIN=python3
# Longest a single engine run may take before it is stopped and reported (ms).
# ENGINE_TIMEOUT_MS=900000
